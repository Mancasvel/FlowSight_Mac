{
  "name": "@flowsight/agent",
  "version": "6.5.4",
  "private": true,
  "description": "FlowSight Agent \u2014 Understand your own Workflows",
  "scripts": {
    "vite": "vite",
    "dev": "tauri dev",
    "dev:stable": "tauri dev --no-watch",
    "fetch-models": "pnpm exec node ../../scripts/fetch-models.mjs",
    "build": "tauri build",
    "test:renderer": "node --test",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --lib --summary-only"
  },
  "dependencies": {
    "@fontsource/manrope": "5",
    "@fontsource/plus-jakarta-sans": "5",
    "@supabase/supabase-js": "^2.112.4",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "dotenv": "^17.4.2",
    "vite": "^7.3.7"
  }
}
